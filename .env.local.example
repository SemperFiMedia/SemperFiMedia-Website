# Public site URL (used in metadata, schema)
NEXT_PUBLIC_SITE_URL=https://semperfimedia.llc

# Mux (video hosting)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
NEXT_PUBLIC_SHOWREEL_PLAYBACK_ID=

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Resend (transactional email for contact form)
RESEND_API_KEY=
CONTACT_FORM_TO_EMAIL=hello@semperfimedia.llc

# Cal.com (if needed for server-side integration; embed works without)
CAL_API_KEY=
NEXT_PUBLIC_CAL_LINK=semperfimedia/discovery

# PostHog (product analytics + session replay + heatmaps)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Business Profile
NEXT_PUBLIC_GBP_PLACE_ID=ChIJ02w-UYGzToYR-HUWwucuIHo
NEXT_PUBLIC_GBP_REVIEW_URL=https://g.page/r/Cfh1FsLnLiB6EBM/review
NEXT_PUBLIC_GBP_PROFILE_URL=https://www.google.com/maps/place/?q=place_id:ChIJ02w-UYGzToYR-HUWwucuIHo

# Discussions (comments) — Postgres + Google auth
DATABASE_URL=postgres://user:password@host:5432/dbname
AUTH_SECRET=generate-with-npx-auth-secret
AUTH_URL=https://semperfimedia.llc
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=semperfimedia.tx@gmail.com

# Analytics — GA4 + Meta Pixel + Meta Conversions API
# NOTE: every NEXT_PUBLIC_* below must ALSO be declared as ARG + ENV in the
# Dockerfile, or it is baked into the browser bundle as an empty string.
# src/lib/env.dockerfile.test.ts enforces this.
NEXT_PUBLIC_ANALYTICS_ENABLED=true
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GA4_DEBUG=false
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LEAD_VALUE_USD=500
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_CODE=

# Chatbot (Claude) — powers /api/chat and the AI wedding proposal generator
ANTHROPIC_API_KEY=
# The chat concierge — runs on every visitor message, so volume drives cost.
# Defaults to claude-opus-5. See src/lib/env.ts for why the two differ.
ANTHROPIC_MODEL=
# The AI wedding proposal generator — runs once per form submission against a
# high-value lead, so capability matters more than rate. Defaults to
# claude-fable-5.
ANTHROPIC_PROPOSAL_MODEL=

# Owner alerts for new leads and bookings (Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
